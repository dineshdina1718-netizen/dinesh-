        "# ================================================================\n",
        "#       AUDIO EQUALIZER DESIGN USING FOURIER SERIES\n",
        "#                 AND HARMONIC ANALYSIS\n",
        "#                 APPLIED MATHEMATICS PROJECT\n",
        "# ================================================================\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from IPython.display import Audio, display\n",
        "from scipy.io.wavfile import write\n",
        "from scipy.fft import rfft, rfftfreq\n",
        "\n",
        "# ================================================================\n",
        "# 1. PROJECT CONFIGURATION\n",
        "# ================================================================\n",
        "\n",
        "fs = 44100                  # Sampling frequency\n",
        "duration = 3                # seconds\n",
        "t = np.arange(0, duration, 1/fs)\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"       AUDIO EQUALIZER DESIGN USING FOURIER SERIES\")\n",
        "print(\"                 AND HARMONIC ANALYSIS\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\"\\nPROJECT PARAMETERS\")\n",
        "print(\"-\" * 75)\n",
        "print(\"Sampling Frequency :\", fs, \"Hz\")\n",
        "print(\"Duration            :\", duration, \"seconds\")\n",
        "print(\"Audio Range         : 20 Hz - 20 kHz\")\n",
        "\n",
        "# ================================================================\n",
        "# 2. GENERATE REALISTIC AUDIO-LIKE SIGNAL\n",
        "# ================================================================\n",
        "\n",
        "# Bass components\n",
        "bass1 = 0.8 * np.sin(2*np.pi*80*t)\n",
        "bass2 = 0.5 * np.sin(2*np.pi*150*t)\n",
        "bass3 = 0.35 * np.sin(2*np.pi*220*t)\n",
        "\n",
        "# Mid components\n",
        "mid1 = 0.45 * np.sin(2*np.pi*500*t)\n",
        "mid2 = 0.35 * np.sin(2*np.pi*1000*t)\n",
        "mid3 = 0.25 * np.sin(2*np.pi*2000*t)\n",
        "\n",
        "# Treble components\n",
        "treble1 = 0.25 * np.sin(2*np.pi*5000*t)\n",
        "treble2 = 0.20 * np.sin(2*np.pi*8000*t)\n",
        "treble3 = 0.15 * np.sin(2*np.pi*12000*t)\n",
        "\n",
        "# Complete audio signal\n",
        "x = (\n",
        "    bass1 + bass2 + bass3 +\n",
        "    mid1 + mid2 + mid3 +\n",
        "    treble1 + treble2 + treble3\n",
        ")\n",
        "\n",
        "# Normalize\n",
        "x = x / np.max(np.abs(x))\n",
        "\n",
        "# ================================================================\n",
        "# 3. ORIGINAL AUDIO WAVEFORM\n",
        "# ================================================================\n",
        "\n",
        "plt.figure(figsize=(15,5))\n",
        "\n",
        "plt.plot(\n",
        "    t,\n",
        "    x,\n",
        "    linewidth=1\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Original Audio Signal\",\n",
        "    fontsize=18,\n",
        "    fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Time (seconds)\", fontsize=13)\n",
        "plt.ylabel(\"Amplitude\", fontsize=13)\n",
        "\n",
        "plt.xlim(0,0.05)\n",
        "\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ================================================================\n",
        "# 4. FOURIER TRANSFORM\n",
        "# ================================================================\n",
        "\n",
        "N = len(x)\n",
        "\n",
        "X = rfft(x)\n",
        "\n",
        "frequencies = rfftfreq(\n",
        "    N,\n",
        "    1/fs\n",
        ")\n",
        "\n",
        "magnitude = (\n",
        "    2/N *\n",
        "    np.abs(X)\n",
        ")\n",
        "\n",
        "# ================================================================\n",
        "# 5. FOURIER FREQUENCY SPECTRUM\n",
        "# ================================================================\n",
        "\n",
        "plt.figure(figsize=(15,6))\n",
        "\n",
        "plt.plot(\n",
        "    frequencies,\n",
        "    magnitude,\n",
        "    linewidth=1\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Fourier Frequency Spectrum of Audio Signal\",\n",
        "    fontsize=18,\n",
        "    fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Frequency (Hz)\", fontsize=13)\n",
        "plt.ylabel(\"Magnitude\", fontsize=13)\n",
        "\n",
        "plt.xlim(0,15000)\n",
        "\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ================================================================\n",
        "# 6. IDENTIFY DOMINANT HARMONICS\n",
        "# ================================================================\n",
        "\n",
        "# Find peaks / largest frequency components\n",
        "\n",
        "indices = np.argsort(magnitude)[-15:]\n",
        "\n",
        "indices = indices[\n",
        "    np.argsort(magnitude[indices])[::-1]\n",
        "]\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 75)\n",
        "print(\"              DOMINANT HARMONIC COMPONENTS\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    f\"{'No.':<8}\"\n",
        "    f\"{'Frequency (Hz)':<20}\"\n",
        "    f\"{'Amplitude':<15}\"\n",
        ")\n",
        "\n",
        "print(\"-\" * 75)\n",
        "\n",
        "for i, index in enumerate(indices):\n",
        "\n",
        "    print(\n",
        "        f\"{i+1:<8}\"\n",
        "        f\"{frequencies[index]:<20.2f}\"\n",
        "        f\"{magnitude[index]:<15.4f}\"\n",
        "    )\n",
        "\n",
        "# ================================================================\n",
        "# 7. FOURIER SERIES REPRESENTATION\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 75)\n",
        "print(\"             FOURIER SERIES REPRESENTATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\"\"\"\n",
        "For a periodic signal x(t):\n",
        "\n",
        "x(t) = a0/2 + Σ [an cos(nω0t) + bn sin(nω0t)]\n",
        "\n",
        "Fourier coefficients:\n",
        "\n",
        "an = (2/T) ∫ x(t) cos(nω0t) dt\n",
        "\n",
        "bn = (2/T) ∫ x(t) sin(nω0t) dt\n",
        "\n",
        "Harmonic amplitude:\n",
        "\n",
        "An = √(an² + bn²)\n",
        "\n",
        "Phase:\n",
        "\n",
        "φn = atan2(bn, an)\n",
        "\"\"\")\n",
        "\n",
        "# ================================================================\n",
        "# 8. CALCULATE FOURIER COEFFICIENTS\n",
        "# ================================================================\n",
        "\n",
        "# Frequencies used for mathematical harmonic analysis\n",
        "\n",
        "analysis_frequencies = np.array([\n",
        "    80,\n",
        "    150,\n",
        "    220,\n",
        "    500,\n",
        "    1000,\n",
        "    2000,\n",
        "    5000,\n",
        "    8000,\n",
        "    12000\n",
        "])\n",
        "\n",
        "a_coeff = []\n",
        "b_coeff = []\n",
        "harmonic_amplitude = []\n",
        "harmonic_phase = []\n",
        "\n",
        "T = duration\n",
        "\n",
        "for f in analysis_frequencies:\n",
        "\n",
        "    cosine_component = np.cos(2*np.pi*f*t)\n",
        "    sine_component = np.sin(2*np.pi*f*t)\n",
        "\n",
        "    an = (\n",
        "        2/T *\n",
        "        np.trapezoid(\n",
        "            x*cosine_component,\n",
        "            t\n",
        "        )\n",
        "    )\n",
        "\n",
        "    bn = (\n",
        "        2/T *\n",
        "        np.trapezoid(\n",
        "            x*sine_component,\n",
        "            t\n",
        "        )\n",
        "    )\n",
        "\n",
        "    A = np.sqrt(\n",
        "        an**2 + bn**2\n",
        "    )\n",
        "\n",
        "    phase = np.arctan2(\n",
        "        bn,\n",
        "        an\n",
        "    )\n",
        "\n",
        "    a_coeff.append(an)\n",
        "    b_coeff.append(bn)\n",
        "    harmonic_amplitude.append(A)\n",
        "    harmonic_phase.append(phase)\n",
        "\n",
        "a_coeff = np.array(a_coeff)\n",
        "b_coeff = np.array(b_coeff)\n",
        "harmonic_amplitude = np.array(harmonic_amplitude)\n",
        "harmonic_phase = np.array(harmonic_phase)\n",
        "\n",
        "# ================================================================\n",
        "# 9. FOURIER COEFFICIENT TABLE\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 75)\n",
        "print(\"                 FOURIER COEFFICIENT TABLE\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    f\"{'Frequency':<15}\"\n",
        "    f\"{'a_n':<15}\"\n",
        "    f\"{'b_n':<15}\"\n",
        "    f\"{'Amplitude':<15}\"\n",
        "    f\"{'Phase(rad)':<15}\"\n",
        ")\n",
        "\n",
        "print(\"-\" * 75)\n",
        "\n",
        "for i in range(len(analysis_frequencies)):\n",
        "\n",
        "    print(\n",
        "        f\"{analysis_frequencies[i]:<15}\"\n",
        "        f\"{a_coeff[i]:<15.4f}\"\n",
        "        f\"{b_coeff[i]:<15.4f}\"\n",
        "        f\"{harmonic_amplitude[i]:<15.4f}\"\n",
        "        f\"{harmonic_phase[i]:<15.4f}\"\n",
        "    )\n",
        "\n",
        "# ================================================================\n",
        "# 10. HARMONIC AMPLITUDE GRAPH\n",
        "# ================================================================\n",
        "\n",
        "plt.figure(figsize=(15,6))\n",
        "\n",
        "plt.stem(\n",
        "    analysis_frequencies,\n",
        "    harmonic_amplitude\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Harmonic Amplitude Analysis\",\n",
        "    fontsize=18,\n",
        "    fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\n",
        "    \"Frequency (Hz)\",\n",
        "    fontsize=13\n",
        ")\n",
        "\n",
        "plt.ylabel(\n",
        "    \"Harmonic Amplitude\",\n",
        "    fontsize=13\n",
        ")\n",
        "\n",
        "plt.grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ================================================================\n",
        "# 11. AUDIO EQUALIZER\n",
        "# ================================================================\n",
        "\n",
        "# ------------------------------------------------\n",
        "# EQUALIZER GAIN SETTINGS\n",
        "# ------------------------------------------------\n",
        "\n",
        "bass_gain = 2.0\n",
        "mid_gain = 1.0\n",
        "treble_gain = 0.45\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 75)\n",
        "print(\"                  EQUALIZER SETTINGS\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\"Bass Gain    :\", bass_gain, \"×\")\n",
        "print(\"Mid Gain     :\", mid_gain, \"×\")\n",
        "print(\"Treble Gain  :\", treble_gain, \"×\")\n",
        "\n",
        "# ================================================================\n",
        "# 12. DEFINE FREQUENCY-DEPENDENT GAIN\n",
        "# ================================================================\n",
        "\n",
        "def equalizer_gain(f):\n",
        "\n",
        "    if f < 250:\n",
        "\n",
        "        return bass_gain\n",
        "\n",
        "    elif f < 4000:\n",
        "\n",
        "        return mid_gain\n",
        "\n",
        "    else:\n",
        "\n",
        "        return treble_gain\n",
        "\n",
        "# Calculate gain for each frequency\n",
        "gains = np.array([\n",
        "    equalizer_gain(f)\n",
        "    for f in analysis_frequencies\n",
        "])\n",
        "\n",
        "# ================================================================\n",
        "# 13. EQUALIZER TABLE\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 75)\n",
        "print(\"                FREQUENCY EQUALIZATION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    f\"{'Frequency':<18}\"\n",
